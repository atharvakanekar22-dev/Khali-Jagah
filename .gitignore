# ==========================================
# Khali Jagah — .gitignore
# ==========================================

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
*.env
!.env.example
backend/.env
backend/.env.*

# Node.js & Dependencies
node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Android & Gradle
.gradle/
android/.gradle/
build/
android/build/
android/app/build/
local.properties
android/local.properties
*.apk
*.aab
*.dex
*.class
.cxx/
android/app/.cxx/

# IDE & Editors
.idea/
.vscode/
*.swp
*.swo
*.iml
android/*.iml
android/app/*.iml
.navigation/

# OS & Logs
.DS_Store
Thumbs.db
*.log
*.tmp

# Temporary test dumps
ui_*.xml
temp/
scratch/
